<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <!-- Только для JUnit вне контейнера; адрес тестовой БД передаёт TestDatabase. -->
    <persistence-unit name="is-lab1-test" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <class>com.github.vodobryshkin.islab1.backend.domain.Address</class>
        <class>com.github.vodobryshkin.islab1.backend.domain.Coordinates</class>
        <class>com.github.vodobryshkin.islab1.backend.domain.Location</class>
        <class>com.github.vodobryshkin.islab1.backend.domain.Organization</class>
        <class>com.github.vodobryshkin.islab1.backend.domain.Person</class>
        <class>com.github.vodobryshkin.islab1.backend.domain.User</class>
        <class>com.github.vodobryshkin.islab1.backend.domain.Worker</class>
        <class>com.github.vodobryshkin.islab1.backend.domain.ZonedDateTimeConverter</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="eclipselink.weaving" value="false"/>
            <!-- Общий кэш выключен: повторное чтение в тестах должно обращаться к БД. -->
            <property name="eclipselink.cache.shared.default" value="false"/>
            <property name="eclipselink.logging.level" value="WARNING"/>
        </properties>
    </persistence-unit>
</persistence>
